generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RO
  CANDIDATE
  SES
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  epicNumber    String    @unique
  email         String    @unique
  phone         String    @unique
  password      String
  role          Role      @default(CANDIDATE)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  otps          Otp[]

  @@index([email])
  @@index([phone])
  @@index([epicNumber])
}

model Otp {
  id        String   @id @default(cuid())
  code      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([code])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}
